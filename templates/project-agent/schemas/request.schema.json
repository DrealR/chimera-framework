{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chimera.example/schemas/project-agent-request-v1.json",
  "title": "Project agent request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "addressed_to", "created_by", "source", "intent", "scope", "acceptance", "authority", "dependencies", "evidence_required", "status"],
  "properties": {
    "schema_version": { "const": "project-agent-request/v1" },
    "request_id": { "type": "string", "pattern": "^[A-Z][A-Z0-9_-]{2,63}$" },
    "addressed_to": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "created_by": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator", "revision"],
      "properties": {
        "kind": { "enum": ["human", "agent", "repository"] },
        "locator": { "type": "string", "minLength": 1 },
        "revision": { "type": ["string", "null"] }
      }
    },
    "intent": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "forbidden": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions", "expires_at"],
      "properties": {
        "actions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence_required": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["OPEN", "CLAIMED", "BLOCKED", "COMPLETE", "CANCELLED"] }
  }
}

